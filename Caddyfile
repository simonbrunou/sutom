# Production web server for sutom on Coolify (homelab CT 126), under either
# build pack. The Dockerfile copies this file to /etc/caddy/Caddyfile and the
# build output to /app/build. Railpack uses this file instead of its default
# SPA template and keeps the output in /app/build too, from
# RAILPACK_SPA_OUTPUT_DIR=build. Railpack renders the file as a Go template,
# comments included, so it must hold no template braces.
#
# Same as railpack's template except for unknown paths: they get 404.html with
# status 404, as on Cloudflare Pages, instead of index.html with status 200.

{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	# SvelteKit puts a content hash in every /_app/immutable/ file name, so a new
	# build never reuses a URL: browsers and Cloudflare may keep them for a year.
	# Without this, Cloudflare's 4 h Browser Cache TTL applied instead.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	root * /app/build

	encode gzip zstd

	try_files {path} {path}.html {path}/index.html

	file_server {
		hide .git .env*
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
